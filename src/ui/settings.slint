// Settings Component
//
// Displays user settings including language selection

import { VerticalBox, HorizontalBox, ComboBox } from "std-widgets.slint";

export struct LanguageOption {
    code: string,
    display: string,
}

export component Settings inherits Rectangle {
    // Properties
    in property <[LanguageOption]> languages: [
        { code: "en", display: "English" },
        { code: "sv", display: "Svenska" },
        { code: "ar", display: "العربية" },
    ];

    in-out property <int> selected-language-index: 1; // Default to Swedish (index 1)

    // Translation strings (passed from MainWindow)
    in property <string> tr-settings;
    in property <string> tr-language-label;
    in property <string> tr-live;
    in property <string> tr-podcasts;

    // Callbacks
    callback language-changed(string /* language code */);

    background: #1a1a1a;

    VerticalBox {
        padding: 20px;
        spacing: 20px;

        // Title
        Text {
            text: tr-settings;
            font-size: 24px;
            color: #ffffff;
            horizontal-alignment: left;
        }

        // Language setting
        HorizontalBox {
            spacing: 10px;
            alignment: start;

            Text {
                text: tr-language-label;
                font-size: 16px;
                color: #ffffff;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }

            ComboBox {
                model: ["English", "Svenska", "العربية"];
                current-index <=> selected-language-index;
                selected(value) => {
                    // Use the current-index property to determine which language was selected
                    if (selected-language-index == 0) {
                        root.language-changed("en");
                    } else if (selected-language-index == 1) {
                        root.language-changed("sv");
                    } else if (selected-language-index == 2) {
                        root.language-changed("ar");
                    }
                }
                horizontal-stretch: 1;
            }
        }

        // Spacer to push content to top
        Rectangle {
            vertical-stretch: 1;
        }
    }
}
