// NowPlaying Component - Displays currently playing channel and program information
// This component shows:
// - Current program details (when available)
// - Program image, title, time, and description

import { VerticalBox, HorizontalBox } from "std-widgets.slint";
import { ProgramInfo } from "types.slint";

export component NowPlaying inherits Rectangle {
    // ================================================================
    // PROPERTIES
    // ================================================================

    // Current channel being played (or "No channel selected")
    in-out property <string> current-channel-name: "No channel selected";

    // Playback state flags
    in-out property <bool> is-playing: false;
    in-out property <bool> is-loading: false;

    // Current program information (populated when a channel is playing)
    in-out property <ProgramInfo> current-program;

    // Live radio state (for LIVE indicator)
    in-out property <bool> is-live: false;
    in-out property <float> playback-duration: 0;

    // ================================================================
    // CALLBACKS
    // ================================================================

    // Called when user clicks "Browse Podcasts" button for current program
    callback browse-podcasts-clicked(int);  // Parameters: (program_id)

    // Called when user clicks the share button to copy episode URL
    callback share-clicked(string);  // Parameters: (episode_url)

    // ================================================================
    // VISUAL STYLING
    // ================================================================
    background: #2a2a2a;
    min-height: 0px;

    // ================================================================
    // LAYOUT
    // ================================================================
    VerticalBox {
        padding: 8px;
        spacing: 8px;

        // Program information section (only visible when program data exists)
        if current-program.title != "": HorizontalBox {
            spacing: 8px;
            padding-top: 8px;

            // Program image/thumbnail
            Image {
                source: current-program.show-image;
                width: 140px;
                height: 140px;
                image-fit: cover;
            }

            // Program text details - constrained to image height
            Rectangle {
                height: 140px;  // Match image height to prevent overflow
                clip: true;     // Clip any content that exceeds bounds

                // Program title (wraps for long podcast episode names)
                Text {
                    text: current-program.title;
                    font-size: 16px;
                    font-weight: 600;
                    font-family: "Segoe UI";
                    color: #e0e0e0;
                    wrap: word-wrap;
                    overflow: elide;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    max-height: 40px;
                }

                // Time range (e.g., "09:00 - 12:00") - positioned below title
                if current-program.start-time != "": Text {
                    text: current-program.start-time + " - " + current-program.end-time;
                    font-size: 12px;
                    font-family: "Segoe UI";
                    color: #aaaaaa;
                    x: 0px;
                    y: 44px;
                }

                // Program description (truncated if too long)
                if current-program.description != "": Text {
                    text: current-program.description;
                    font-size: 12px;
                    font-family: "Segoe UI";
                    color: #999999;
                    wrap: word-wrap;
                    overflow: elide;
                    x: 0px;
                    y: 62px;
                    width: parent.width;
                    max-height: 78px;  // 140 - 62 = 78px remaining space
                }
            }
        }
    }

    // ================================================================
    // LIVE INDICATOR (Bottom Right Corner - aligned with artwork bottom)
    // ================================================================
    // LIVE indicator (shown for live radio at live edge)
    if playback-duration == 0 && is-live && current-program.title != "": Rectangle {
        x: parent.width - self.width - 16px;
        y: 138px;  // Align bottom with artwork: (8 + 8 + 140) - 18 = 138px
        width: 45px;
        height: 18px;
        background: #EF4444;
        border-radius: 3px;

        Text {
            text: "LIVE";
            color: #ffffff;
            font-size: 10px;
            font-weight: 700;
            font-family: "Segoe UI";
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // ================================================================
    // SHARE BUTTON (Bottom Right Corner - next to LIVE indicator)
    // ================================================================
    if current-program.episode-url != "": Rectangle {
        // Position to the left of LIVE indicator (or at same spot if no LIVE)
        x: playback-duration == 0 && is-live && current-program.title != ""
            ? parent.width - 45px - 16px - self.width - 8px  // Left of LIVE with 8px gap
            : parent.width - self.width - 16px;              // Same position as LIVE when not live
        y: 138px;  // Same y-position as LIVE indicator
        width: 32px;
        height: 18px;  // Same height as LIVE indicator
        background: share-touch.has-hover ? #4a4a4a : #3a3a3a;
        border-radius: 3px;  // Same border-radius as LIVE indicator

        share-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                share-clicked(current-program.episode-url);
            }
        }

        // Share icon
        Image {
            source: @image-url("../assets/icons/share.svg");
            width: 12px;
            height: 12px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            colorize: #ffffff;
        }
    }
}