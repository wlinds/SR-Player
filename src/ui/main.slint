// Slint UI definition for SR Player
//
// This is the main application window that brings together all UI components:
// - NowPlaying: Shows current channel and program information
// - TabContent: Reusable component for Live, Podcasts, News, Music tabs
// - Tab navigation and content switching
//
// SLINT is a declarative UI framework (like HTML/CSS or SwiftUI)
//
// Compare to:
// - HTML: Describes WHAT the UI looks like (not HOW to build it)
// - React JSX: Component-based, but Slint is compiled to native code
// - Qt QML: Very similar! Slint was inspired by QML
//
// Key concepts:
// - Components are like React components or HTML elements
// - Properties are like React props or HTML attributes
// - Callbacks are like JavaScript event handlers (onClick, etc.)

// Import standard widgets from Slint's widget library
// Like: import { Button } from 'react' or from tkinter import Button
import { Button, VerticalBox, HorizontalBox, ListView, ScrollView, Slider } from "std-widgets.slint";


import { ChannelItem, ProgramInfo, ProgramItem, EpisodeItem } from "types.slint";

import { NowPlaying } from "now_playing.slint";
import { TabContent } from "tab_content.slint";
import { TabBar, TabItem } from "tab_bar.slint";

// Re-export types so they're available to Rust code
export { ChannelItem, ProgramInfo, ProgramItem, EpisodeItem }

// Main application window component
// Like <App> component in React or main() window in Tkinter
export component MainWindow inherits Window {
    // ================================================================
    // WINDOW PROPERTIES
    // ================================================================
    title: "SR Player - Sveriges Radio";
    // no-frame: true;
    min-width: 300px;
    min-height: 300px;
    preferred-width: 360px;
    preferred-height: 600px;
    background: #1a1a1a;
    // Use Segoe UI on Windows for consistent font rendering and symbol support
    default-font-family: "Segoe UI";

    // ================================================================
    // TIMER FOR PROGRESS UPDATES
    // ================================================================
    // Update playback position every second when playing (for both episodes and live radio)
    Timer {
        interval: 1s;
        running: is-playing && (playback-duration > 0 || current-program.start-time != "");
        triggered => {
            // For episodes: increment position directly
            if (playback-duration > 0 && playback-position < playback-duration) {
                playback-position += 1.0;
            }
            // For live radio at live edge: call Rust callback to calculate position based on current time
            else if (playback-duration == 0 && is-live && current-program.start-time != "") {
                update-live-position();
            }
            // For time-shifted playback (live radio but not at live edge): increment position
            else if (playback-duration == 0 && !is-live && program-duration > 0) {
                if (playback-position < program-duration) {
                    playback-position += 1.0;
                }
            }
        }
    }

    // ================================================================
    // APPLICATION STATE
    // ================================================================

    // Current playback state
    in-out property <string> current-channel-name: "No channel selected";
    in-out property <bool> is-playing: false;
    in-out property <bool> is-loading: false;
    in-out property <float> volume: 0.5;                // Volume level 0.0 to 1.0
    in-out property <float> playback-position: 0.0;     // Current position in seconds
    in-out property <float> playback-duration: 0.0;     // Total duration in seconds (episodes)
    in-out property <float> program-duration: 0.0;      // Total duration in seconds (live radio programs)
    in-out property <string> download-status: "";       // Download status message
    in-out property <float> buffer-depth: 0.0;          // DVR buffer depth in seconds
    in-out property <bool> is-live: true;               // True if at live edge, false if time-shifted
    in-out property <ProgramInfo> current-program: {
        title: "",
        description: "",
        start-time: "",
        end-time: "",
        show-image: @image-url(""),
        program-id: 0,
        has-podcasts: false
    };

    // Tab management (0=Live, 1=Podcasts, 2=News, 3=Music, 4=Favorites)
    in-out property <int> current-tab: 0;

    // Data arrays for different tabs
    in-out property <[ChannelItem]> channels: [];
    in-out property <[ProgramItem]> programs: [];  // For Podcasts tab
    in-out property <[ProgramItem]> news-programs: [];  // For News tab
    in-out property <[EpisodeItem]> episodes: [];
    in-out property <[ChannelItem]> favorite-channels: [];  // For Favorites tab
    in-out property <[ProgramItem]> favorite-programs: [];  // For Favorites tab

    // Search functionality
    in-out property <string> podcast-search-query: "";

    // View state for Podcasts/News tabs
    in-out property <string> selected-program-name: "";
    in-out property <int> selected-program-id: 0;
    in-out property <bool> show-episodes-view: false;
    in-out property <bool> programs-loaded: false;
    in-out property <bool> news-loaded: false;

    // ================================================================
    // CALLBACKS (Event Handlers)
    // ================================================================

    // Channel selection (Live tab)
    callback channel-selected(int, string);  // (channel_id, stream_url)

    // Playback controls
    callback play-pause-clicked();
    callback volume-changed(float);     // (volume 0.0 to 1.0)
    callback seek-to-position(float);   // (position in seconds)
    callback update-live-position();    // Update live radio progress

    // Program browsing
    callback browse-podcasts-clicked(int);  // (program_id)
    callback program-selected(int);         // (program_id)
    callback episode-selected(int);         // (episode_id)
    callback back-to-programs-clicked();

    // Tab navigation
    callback podcasts-tab-clicked();
    callback news-tab-clicked();

    // Group expansion (for P4 Local News, Ekot News)
    callback group-toggled(int);  // (group_id)

    // Pagination (if needed)
    callback load-more-programs();
    callback window-moved(length, length);  // Callback for window dragging

    // Search callback
    callback search-programs(string);  // (search_query)

    // Favorites callbacks
    callback toggle-favorite-channel(int);  // (channel_id)
    callback toggle-favorite-program(int);  // (program_id)
    callback favorites-tab-clicked();

    // ================================================================
    // MAIN LAYOUT
    // ================================================================
    // WINDOW DRAGGING (for frameless window)
    // ================================================================
    TouchArea {
        width: 100%;
        height: 100%;

        moved => {
            if (self.pressed) {
                root.window-moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }

    // ================================================================
    FocusScope {
        enabled: true;

        key-pressed(event) => {
            // Space bar toggles play/pause
            if (event.text == " ") {
                root.play-pause-clicked();
                return accept;
            }
            return reject;
        }

        init => {
            self.focus();
        }

        VerticalBox {
            padding: 0px;
            spacing: 0px;

        // ================================================================
        // NOW PLAYING SECTION
        // ================================================================
        NowPlaying {
            current-channel-name: root.current-channel-name;
            is-playing: root.is-playing;
            is-loading: root.is-loading;
            current-program: root.current-program;
            is-live: root.is-live;
            playback-duration: root.playback-duration;

            browse-podcasts-clicked(program-id) => {
                root.browse-podcasts-clicked(program-id);
            }
        }

        // ================================================================
        // PLAYBACK CONTROLS (Full width, right below Now Playing)
        // ================================================================
        VerticalBox {
            spacing: 0px;
            padding: 0px;

            // Progress bar (shown for episodes OR live radio with program info, even when paused)
            if playback-duration > 0 || current-program.start-time != "": VerticalBox {
                spacing: 0px;
                padding: 0px;
                vertical-stretch: 0;

                // Progress bar background with larger hit area
                Rectangle {
                    height: 4px;

                    // Actual visual progress bar
                    Rectangle {
                        y: 0px; 
                        height: 4px;
                        width: parent.width;
                        background: #1a1a1a;
                        border-radius: 0px;

                        // Filled portion (anchored to left)
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: {
                                if (playback-duration > 0) {
                                    // Episode: position / duration
                                    parent.width * (playback-position / playback-duration)
                                } else if (program-duration > 0) {
                                    // Live radio: position / program duration
                                    parent.width * (playback-position / program-duration)
                                } else {
                                    // No duration info, show nothing
                                    0px
                                }
                            };
                            height: parent.height;
                            background: #EFA669;
                            border-radius: 0px;
                        }
                    }

                    // Touch area for seeking (episodes OR live radio with DVR buffer)
                    if playback-duration > 0 || program-duration > 0: TouchArea {
                        width: 100%;
                        height: 100%;  // Now covers the full 20px height
                        mouse-cursor: pointer;

                        property <float> hover-position: (self.mouse-x / self.width) *
                            (playback-duration > 0 ? playback-duration : program-duration);
                        property <length> tooltip-x: clamp(self.mouse-x - 30px, 0px, self.width - 60px);

                        clicked => {
                            debug("TouchArea clicked!");
                            debug("playback-duration:", playback-duration);
                            debug("program-duration:", program-duration);
                            if playback-duration > 0 {
                                // Episode seeking
                                let position = (self.mouse-x / self.width) * playback-duration;
                                debug("Episode seek to position:", position);
                                root.playback-position = position;
                                root.seek-to-position(position);
                            } else if program-duration > 0 {
                                // Live radio DVR seeking
                                let position = (self.mouse-x / self.width) * program-duration;
                                debug("Live radio seek to position:", position);
                                root.playback-position = position;
                                root.seek-to-position(position);
                            }
                        }

                        // Hover tooltip showing time at cursor position
                        if self.has-hover: Rectangle {
                            x: tooltip-x;
                            y: -30px;
                            width: 60px;
                            height: 24px;
                            background: #000000;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #444444;

                            Text {
                                text: {
                                    let minutes = Math.floor(hover-position / 60);
                                    let seconds = Math.floor(Math.mod(hover-position, 60));
                                    minutes + ":" + (seconds < 10 ? "0" : "") + seconds
                                };
                                color: #ffffff;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Time labels
                HorizontalBox {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 4px;

                    // Left time (episode position or live radio current position)
                    Text {
                        text: {
                            playback-duration > 0 ?
                                // Episode: show position as mm:ss
                                (Math.floor(playback-position / 60) + ":" +
                                (Math.floor(Math.mod(playback-position, 60)) < 10 ? "0" : "") +
                                Math.floor(Math.mod(playback-position, 60))) :
                                // Live radio: show current position as mm:ss
                                (Math.floor(playback-position / 60) + ":" +
                                (Math.floor(Math.mod(playback-position, 60)) < 10 ? "0" : "") +
                                Math.floor(Math.mod(playback-position, 60)))
                        };
                        color: #888888;
                        font-size: 11px;
                    }

                    // Spacer
                    Rectangle {
                        horizontal-stretch: 1;
                    }

                    // Right time (episode remaining or live radio remaining)
                    Text {
                        text: {
                            playback-duration > 0 ?
                                // Episode: show remaining time
                                ("-" + Math.floor((playback-duration - playback-position) / 60) + ":" +
                                (Math.floor(Math.mod(playback-duration - playback-position, 60)) < 10 ? "0" : "") +
                                Math.floor(Math.mod(playback-duration - playback-position, 60))) :
                                // Live radio: show remaining time
                                (program-duration > 0 ?
                                    ("-" + Math.floor((program-duration - playback-position) / 60) + ":" +
                                    (Math.floor(Math.mod(program-duration - playback-position, 60)) < 10 ? "0" : "") +
                                    Math.floor(Math.mod(program-duration - playback-position, 60))) :
                                    current-program.end-time)
                        };
                        color: #888888;
                        font-size: 11px;
                    }
                }

                // Download status
                if download-status != "": HorizontalBox {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 0px;
                    padding-bottom: 2px;
                    alignment: center;

                    Text {
                        text: download-status;
                        color: #4CAF50;
                        font-size: 10px;
                    }
                }
            }

            // Playback controls and volume
            HorizontalBox {
                spacing: 8px;
                padding-left: 8px;
                padding-right: 8px;
                padding-top: (playback-duration > 0 || current-program.start-time != "") ? 0px : 8px;

                // Play/Pause button
                Rectangle {
                    width: 40px;
                    height: 40px;
                    background: !is-loading ? #3a3a3a : #2a2a2a;
                    border-radius: 20px;

                    Image {
                        source: is-playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg");
                        width: 24px;
                        height: 24px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        colorize: #ffffff;
                    }

                    TouchArea {
                        clicked => {
                            if (!is-loading) {
                                play-pause-clicked();
                            }
                        }
                        mouse-cursor: !is-loading ? pointer : default;
                    }
                }

                // Volume controls (takes remaining space)
                HorizontalLayout {
                    spacing: 8px;

                    // Volume label
                    Text {
                        text: "Vol:";
                        color: #666666;
                        vertical-alignment: center;
                        font-size: 14px;
                    }

                    // Volume slider wrapper for vertical centering
                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;

                        // Volume slider with subtle grey accent
                        Rectangle {
                            height: 4px;
                            width: parent.width;
                            y: (parent.height - self.height) / 2;
                            background: #2a2a2a;
                            border-radius: 2px;

                            // Filled portion (anchored to left)
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: parent.width * root.volume;
                                height: parent.height;
                                background: #666666;
                                border-radius: 2px;
                            }

                            // Touch area for interaction
                            TouchArea {
                                width: parent.width;
                                height: parent.height;

                                clicked => {
                                    root.volume = self.mouse-x / self.width;
                                    root.volume-changed(root.volume * root.volume);
                                }

                                moved => {
                                    if (self.pressed) {
                                        root.volume = clamp(self.mouse-x / self.width, 0, 1);
                                        root.volume-changed(root.volume * root.volume);
                                    }
                                }
                            }
                        }
                    }

                    // Volume percentage
                    Text {
                        text: Math.round(root.volume * root.volume * 100) + "%";
                        color: #666666;
                        vertical-alignment: center;
                        min-width: 35px;
                        font-size: 14px;
                    }
                }
            }

            // Browse Podcasts button (only shown when current program has podcasts)
            if current-program.has-podcasts && current-program.program-id > 0: HorizontalBox {
                alignment: center;
                padding-left: 8px;
                padding-right: 8px;

                Button {
                    text: "Browse Podcasts";
                    clicked => {
                        browse-podcasts-clicked(current-program.program-id);
                    }
                }
            }
        }

        // ================================================================
        // TAB NAVIGATION
        // ================================================================
        VerticalBox {
            spacing: 4px;
            padding: 0px;
            padding-top: 8px;

            TabBar {
                current-tab <=> root.current-tab;  // Two-way binding

                tab-clicked(tab-id) => {
                    // Handle special logic for specific tabs
                    if (tab-id == 1) {
                        // Podcasts tab
                        show-episodes-view = false;
                        podcasts-tab-clicked();
                    } else if (tab-id == 2) {
                        // News tab
                        show-episodes-view = false;
                        news-tab-clicked();
                    } else if (tab-id == 4) {
                        // Favorites tab
                        show-episodes-view = false;
                        favorites-tab-clicked();
                    }
                    // For Live (0) and Music (3), just switching the tab is enough
                }
            }

            // ================================================================
            // TAB CONTENT AREA
            // ================================================================

            // Live Tab - Channel list
            if current-tab == 0: TabContent {
            is-channels-tab: true;
            channels: root.channels;
            is-loaded: true;
            loading-text: "Loading channels...";
            empty-text: "No channels found";
            show-favorite-buttons: true;

            channel-selected(id, url) => {
                root.channel-selected(id, url);
            }

            favorite-channel-clicked(id) => {
                root.toggle-favorite-channel(id);
            }
        }

        // Podcasts Tab - Programs list or episodes with search
        if current-tab == 1: VerticalBox {
            spacing: 8px;
            padding: 0px;

            // Search input (only shown when viewing programs list, not episodes)
            if !show-episodes-view: HorizontalBox {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 8px;
                padding-bottom: 4px;
                spacing: 8px;

                Rectangle {
                    horizontal-stretch: 1;
                    height: 32px;
                    background: #1a1a1a;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: #444444;

                    HorizontalBox {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;

                        // Search input
                        Rectangle {
                            horizontal-stretch: 1;

                            TextInput {
                                text <=> root.podcast-search-query;
                                font-size: 14px;
                                color: #ffffff;
                                width: parent.width;
                                height: parent.height;

                                edited => {
                                    root.search-programs(self.text);
                                }
                            }

                            // Placeholder text (shown when input is empty)
                            if root.podcast-search-query == "": Text {
                                text: "Search podcasts...";
                                font-size: 14px;
                                color: #666666;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            TabContent {
                vertical-stretch: 1;

                // Switch between programs list and episodes view
                show-back-button: show-episodes-view;
                selected-program-name: root.selected-program-name;

                // Show either programs or episodes
                is-programs-tab: !show-episodes-view;
                is-episodes-tab: show-episodes-view;

                programs: root.programs;
                episodes: root.episodes;
                is-loaded: programs-loaded;
                loading-text: "Loading programs...";
                empty-text: show-episodes-view ? "No episodes found" : "No programs found";
                show-favorite-buttons: true;

                program-selected(id) => {
                    root.program-selected(id);
                }

                group-toggled(id) => {
                    root.group-toggled(id);
                }

                episode-selected(id) => {
                    root.episode-selected(id);
                }

                back-clicked => {
                    root.back-to-programs-clicked();
                }

                favorite-program-clicked(id) => {
                    root.toggle-favorite-program(id);
                }
            }
        }

        // News Tab - News programs with groups (same structure as Podcasts)
        if current-tab == 2: TabContent {
            // Switch between programs list and episodes view
            show-back-button: show-episodes-view;
            selected-program-name: root.selected-program-name;

            // Show either programs or episodes
            is-programs-tab: !show-episodes-view;
            is-episodes-tab: show-episodes-view;

            programs: root.news-programs;
            episodes: root.episodes;
            is-loaded: news-loaded;
            loading-text: "Loading news programs...";
            empty-text: show-episodes-view ? "No episodes found" : "No news programs found";

            program-selected(id) => {
                root.program-selected(id);
            }

            group-toggled(id) => {
                root.group-toggled(id);
            }

            episode-selected(id) => {
                root.episode-selected(id);
            }

            back-clicked => {
                root.back-to-programs-clicked();
            }
        }

        // Music Tab - Placeholder using TabContent
        if current-tab == 3: TabContent {
            show-simple-text: true;
            simple-text: "Music content coming soon...";
            simple-text-color: #888888;
            is-loaded: true;
        }

        // Favorites Tab - Shows favorite channels and programs
        if current-tab == 4: VerticalLayout {
            vertical-stretch: 1;

            // Show channels if any
            if favorite-channels.length > 0: TabContent {
                is-channels-tab: true;
                channels: root.favorite-channels;
                is-loaded: true;
                empty-text: "";
                show-favorite-buttons: true;

                channel-selected(id, url) => {
                    root.channel-selected(id, url);
                }

                favorite-channel-clicked(id) => {
                    root.toggle-favorite-channel(id);
                }
            }

            // Show programs if any
            if favorite-programs.length > 0: TabContent {
                is-programs-tab: true;
                programs: root.favorite-programs;
                is-loaded: true;
                empty-text: "";
                show-favorite-buttons: true;

                program-selected(id) => {
                    root.program-selected(id);
                }

                favorite-program-clicked(id) => {
                    root.toggle-favorite-program(id);
                }
            }

            // Empty state when no favorites
            if favorite-channels.length == 0 && favorite-programs.length == 0: Text {
                text: "No favorites yet. Click the star icon on channels or podcasts to add them.";
                font-size: 14px;
                color: #888888;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        } // end tab navigation VerticalBox
    } // end main VerticalBox
    } // end FocusScope
}