<?xml version='1.0' encoding='windows-1252'?>
<!--
  WiX Configuration for SR-Player Windows Installer

  This creates an MSI installer that:
  - Installs to Program Files
  - Creates Start Menu shortcut
  - Adds to Programs and Features
  - Handles proper uninstallation
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
    <?define Win64 = "yes" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
    <?define Win64 = "no" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='SR Player'
        UpgradeCode='12345678-1234-1234-1234-123456789012'
        Manufacturer='SR Player'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package
            Id='*'
            Keywords='Installer'
            Description='Sveriges Radio streaming application'
            Manufacturer='SR Player'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            Platform='$(var.Platform)'/>

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='SR Player Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='SR Player'>
                    <Component Id='MainExecutable' Guid='*' Win64='$(var.Win64)'>
                        <File
                            Id='SRPlayerEXE'
                            Name='sr-player.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\sr-player.exe'
                            KeyPath='yes'/>
                    </Component>

                    <Component Id='License' Guid='*' Win64='$(var.Win64)'>
                        <File Id='LicenseFile' Name='LICENSE' DiskId='1' Source='wix\License.rtf' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='SR Player'>
                    <Component Id='ApplicationShortcut' Guid='*' Win64='$(var.Win64)'>
                        <Shortcut
                            Id='ApplicationStartMenuShortcut'
                            Name='SR Player'
                            Description='Sveriges Radio Streaming Application'
                            Target='[#SRPlayerEXE]'
                            WorkingDirectory='APPLICATIONFOLDER'/>
                        <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU' Key='Software\SR Player' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>

            <Directory Id='DesktopFolder' Name='Desktop'>
                <Component Id='ApplicationShortcutDesktop' Guid='*' Win64='$(var.Win64)'>
                    <Shortcut
                        Id='ApplicationDesktopShortcut'
                        Name='SR Player'
                        Description='Sveriges Radio Streaming Application'
                        Target='[#SRPlayerEXE]'
                        WorkingDirectory='APPLICATIONFOLDER'/>
                    <RemoveFolder Id='DesktopFolder' On='uninstall'/>
                    <RegistryValue Root='HKCU' Key='Software\SR Player' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
                </Component>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs SR Player'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='MainExecutable'/>
            <ComponentRef Id='License'/>
            <ComponentRef Id='ApplicationShortcut'/>
            <ComponentRef Id='ApplicationShortcutDesktop'/>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='wix\Product.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/yourusername/SR-Player'/>
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>

        <UIRef Id='WixUI_InstallDir'/>
        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>
        <WixVariable Id='WixUIDialogBmp' Value='wix\Dialog.bmp'/>

    </Product>
</Wix>
